# 複製成 .env.local 給本機測試用（npx vercel dev）；正式環境請在 Vercel 專案 Settings → Environment Variables 設定

# LINE Messaging API（LINE Developers Console → 你的 Channel）
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 管理系統（網站「系統 → LINE 管理」可以複製）
GAS_URL=
BOT_SECRET=

# ===== 選填 =====
# 時區（預設 Asia/Taipei）
BOT_TIMEZONE=
# 網站網址：機器人請使用者「到網站操作」時附上（例如 https://omg8787.github.io/FonegleWeb/）
SITE_URL=
